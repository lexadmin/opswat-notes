{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Lex \u200b\u7684\u200b\u8cc7\u200b\u5b89\u6280\u200b\u8853\u200b\u7b46\u8a18","text":"<p>\u200b\u6b61\u8fce\u200b\u3002\u200b\u9019\u88e1\u200b\u6574\u7406\u200b OPSWAT \u200b\u89e3\u6c7a\u200b\u65b9\u6848\u200b\u7684\u200b\u5be6\u4f5c\u200b\u7b46\u8a18\u200b\u8207\u200b\u4e2d\u6587\u200b\u5c0e\u8b80\u200b\uff0c\u200b\u4ee5\u5be6\u969b\u200b\u90e8\u7f72\u200b\u7d93\u9a57\u200b\u3001\u200b\u8a2d\u5b9a\u200b\u7bc4\u4f8b\u200b\u8207\u200b\u8e29\u200b\u96f7\u7d00\u9304\u200b\u70ba\u200b\u4e3b\u200b\uff0c\u200b\u65b9\u4fbf\u200b\u5167\u90e8\u200b\u5718\u968a\u200b\u8207\u200b\u5ba2\u6236\u200b\u5feb\u901f\u200b\u4e0a\u200b\u624b\u200b\u3002</p> <p>\u200b\u95dc\u65bc\u200b\u672c\u7ad9\u200b</p> <p>\u200b\u672c\u7ad9\u200b\u70ba\u200b\u539f\u5275\u200b\u5be6\u4f5c\u200b\u7b46\u8a18\u200b\u8207\u200b\u4e2d\u6587\u200b\u5c0e\u8b80\u200b\uff0c\u200b\u975e\u5b98\u65b9\u200b\u6587\u4ef6\u200b\u7ffb\u8b6f\u200b\u3002\u200b\u7522\u54c1\u200b\u7684\u200b\u5b8c\u6574\u200b\u898f\u683c\u200b\u8207\u200b\u6700\u65b0\u200b\u8cc7\u8a0a\u200b\uff0c\u200b\u8acb\u4ee5\u200b OPSWAT \u200b\u5b98\u65b9\u200b\u6587\u4ef6\u200b\u70ba\u6e96\u200b\u3002</p>"},{"location":"#_1","title":"\u5167\u5bb9\u5c0e\u89bd","text":"<ul> <li>MetaDefender Core \u200b\u4e2d\u6587\u200b\u5c0e\u8b80\u200b \u2014\u2014 \u200b\u591a\u200b\u9632\u6bd2\u200b\u5f15\u64ce\u200b\u6383\u63cf\u200b\u3001Deep CDR\u3001Sandbox \u200b\u7684\u200b\u6982\u5ff5\u200b\u8207\u200b\u90e8\u7f72\u200b\u3002</li> </ul>"},{"location":"#_2","title":"\u600e\u9ebc\u200b\u4f7f\u7528\u200b\u9019\u4efd\u200b\u7b46\u8a18","text":"<ul> <li>\u200b\u5de6\u5074\u200b\u662f\u200b\u5206\u985e\u200b\u5c0e\u89bd\u200b\uff0c\u200b\u53f3\u5074\u200b\u662f\u200b\u672c\u9801\u200b\u76ee\u9304\u200b\uff0c\u200b\u9802\u90e8\u200b\u6709\u200b\u5168\u7ad9\u200b\u641c\u5c0b\u200b\uff08\u200b\u652f\u63f4\u200b\u4e2d\u6587\u200b\uff09\u3002</li> <li>\u200b\u6a19\u793a\u200b\u984f\u8272\u200b\u7684\u200b\u63d0\u793a\u6846\u200b\u662f\u200b\u5be6\u52d9\u200b\u91cd\u9ede\u200b\u8207\u200b\u96f7\u5340\u200b\uff0c\u200b\u8acb\u200b\u7279\u5225\u200b\u7559\u610f\u200b\u3002</li> </ul>"},{"location":"icap/overview/","title":"ICAP \u200b\u53cd\u5411\u200b\u4ee3\u7406\u200b\u6574\u5408\u200b\u5c0e\u8b80","text":"<p>MetaDefender ICAP Server \u200b\u8b93\u200b\u4f60\u200b\u628a\u200b\u6a94\u6848\u200b\u5b89\u5168\u200b\u6aa2\u6e2c\u200b\u300c\u200b\u63d2\u200b\u300d\u200b\u9032\u73fe\u200b\u6709\u200b\u7684\u200b\u7db2\u8def\u200b\u6d41\u91cf\u200b\u88e1\u200b\uff0c\u200b\u4e0d\u7528\u200b\u6539\u52d5\u200b\u61c9\u7528\u200b\u7cfb\u7d71\u200b\u672c\u8eab\u200b\u3002</p>"},{"location":"icap/overview/#_1","title":"\u4e00\u53e5\u200b\u8a71\u200b\u7406\u89e3","text":"<p>ICAP \u200b\u662f\u200b\u4e00\u7a2e\u200b\u6a19\u6e96\u200b\u5354\u5b9a\u200b\uff0c\u200b\u4f5c\u7528\u200b\u50cf\u200b\u5728\u200b\u4f60\u200b\u7684\u200b\u7db2\u8def\u200b\u95dc\u5361\u65c1\u200b\u908a\u52a0\u200b\u4e00\u500b\u6aa2\u200b\u67e5\u54e8\u200b\uff1a\u200b\u6d41\u91cf\u200b\u7d93\u904e\u200b\u53cd\u5411\u200b\u4ee3\u7406\u200b\u3001\u200b\u8ca0\u8f09\u200b\u5e73\u8861\u5668\u200b\u6216\u200b WAF \u200b\u6642\u200b\uff0c\u200b\u9806\u200b\u624b\u628a\u200b\u6a94\u6848\u200b\u4e1f\u7d66\u200b MetaDefender \u200b\u6383\u200b\u4e00\u4e0b\u200b\uff0c\u200b\u4e7e\u6de8\u200b\u624d\u200b\u653e\u884c\u200b\u3002</p>"},{"location":"icap/overview/#_2","title":"\u9069\u5408\u200b\u7684\u200b\u5834\u666f","text":"<ul> <li>\u200b\u4f7f\u7528\u8005\u200b\u900f\u904e\u200b\u7db2\u9801\u200b\u4e0a\u200b\u50b3\u200b / \u200b\u4e0b\u8f09\u200b\u6a94\u6848\u200b\uff0c\u200b\u60f3\u200b\u5728\u200b\u4e0d\u200b\u6539\u200b\u7a0b\u5f0f\u200b\u7684\u200b\u524d\u63d0\u200b\u4e0b\u200b\u52a0\u4e0a\u200b\u5b89\u5168\u200b\u6383\u63cf\u200b\u3002</li> <li>\u200b\u5df2\u7d93\u200b\u6709\u200b F5\u3001Fortinet\u3001Squid \u200b\u7b49\u200b\u652f\u63f4\u200b ICAP \u200b\u7684\u200b\u8a2d\u5099\u200b\uff0c\u200b\u60f3\u200b\u76f4\u63a5\u200b\u4e32\u63a5\u200b\u3002</li> </ul> <p>\u200b\u9019\u7bc7\u200b\u9084\u5728\u200b\u6574\u7406\u200b\u4e2d\u200b</p> <p>ICAP \u200b\u7684\u200b\u5be6\u969b\u200b\u4e32\u63a5\u200b\u8a2d\u5b9a\u200b\uff08\u200b\u542b\u200b\u5404\u5bb6\u200b\u8a2d\u5099\u200b\u7bc4\u4f8b\u200b\uff09\u200b\u6703\u9678\u7e8c\u200b\u88dc\u4e0a\u200b\u3002\u200b\u6709\u200b\u60f3\u200b\u512a\u5148\u200b\u770b\u5230\u200b\u7684\u200b\u8a2d\u5099\u200b\u6b61\u8fce\u200b\u63d0\u51fa\u200b\u3002</p> <p>\u200b\u6700\u200b\u5f8c\u200b\u66f4\u65b0\u200b\uff1a2026-08-17</p>"},{"location":"metadefender-core/installation/","title":"\u5b89\u88dd\u200b\u8207\u200b\u90e8\u7f72","text":"<p>\u200b\u672c\u7bc7\u200b\u8a18\u9304\u200b\u5728\u200b Linux \u200b\u74b0\u5883\u200b\u5b89\u88dd\u200b MetaDefender Core \u200b\u7684\u200b\u5b8c\u6574\u200b\u6d41\u7a0b\u200b\uff0c\u200b\u9069\u7528\u200b\u65bc\u200b\u55ae\u6a5f\u200b\u90e8\u7f72\u200b\u8207\u200b LAB \u200b\u6e2c\u8a66\u200b\u74b0\u5883\u200b\u3002</p>"},{"location":"metadefender-core/installation/#_2","title":"\u7cfb\u7d71\u200b\u9700\u6c42","text":"<p>\u200b\u6b63\u5f0f\u200b\u90e8\u7f72\u200b\u524d\u200b\u8acb\u78ba\u200b\u8a8d\u4e3b\u6a5f\u200b\u8cc7\u6e90\u200b\uff0c\u200b\u5f15\u64ce\u200b\u6578\u91cf\u200b\u8d8a\u200b\u591a\u200b\u3001\u200b\u8a18\u61b6\u9ad4\u200b\u9700\u6c42\u200b\u8d8a\u9ad8\u200b\uff1a</p> \u200b\u9805\u76ee\u200b \u200b\u6700\u4f4e\u200b\u9700\u6c42\u200b \u200b\u5efa\u8b70\u503c\u200b CPU 4 \u200b\u6838\u5fc3\u200b 8 \u200b\u6838\u5fc3\u200b\u4ee5\u4e0a\u200b \u200b\u8a18\u61b6\u9ad4\u200b 8 GB 16 GB \u200b\u4ee5\u4e0a\u200b \u200b\u78c1\u789f\u200b\u7a7a\u9593\u200b 40 GB 100 GB\uff08\u200b\u542b\u200b\u5f15\u64ce\u200b\u66f4\u65b0\u200b\uff09 \u200b\u4f5c\u696d\u200b\u7cfb\u7d71\u200b Ubuntu 20.04 / 22.04\u3001RHEL 8 / 9 \u2014"},{"location":"metadefender-core/installation/#_3","title":"\u5b89\u88dd\u6b65\u200b\u9a5f","text":"<p>\u200b\u4f9d\u200b\u4f60\u200b\u7684\u200b\u4f5c\u696d\u200b\u7cfb\u7d71\u200b\u9078\u64c7\u200b\u5c0d\u200b\u61c9\u200b\u6307\u4ee4\u200b\uff1a</p> Ubuntu / DebianRHEL / Rocky Linux <pre><code># \u200b\u66f4\u65b0\u200b\u5957\u4ef6\u200b\u6e05\u55ae\u200b\u4e26\u5b89\u88dd\u200b\u4e0b\u8f09\u200b\u5de5\u5177\u200b\nsudo apt update &amp;&amp; sudo apt install -y wget\n\n# \u200b\u4e0b\u8f09\u200b\u4e26\u5b89\u88dd\u200b MetaDefender Core\nwget \"https://software.opswat.com/ometascan.deb\"\nsudo dpkg -i ometascan.deb\n</code></pre> <pre><code># \u200b\u5b89\u88dd\u200b\u4e0b\u8f09\u200b\u5de5\u5177\u200b\nsudo dnf install -y wget\n\n# \u200b\u4e0b\u8f09\u200b\u4e26\u5b89\u88dd\u200b MetaDefender Core\nwget \"https://software.opswat.com/ometascan.rpm\"\nsudo rpm -i ometascan.rpm\n</code></pre> <p>\u200b\u5148\u958b\u200b\u597d\u200b\u9632\u706b\u200b\u7246\u200b</p> <p>\u200b\u9996\u6b21\u200b\u555f\u52d5\u524d\u200b\uff0c\u200b\u8acb\u200b\u78ba\u8a8d\u200b\u9632\u706b\u200b\u7246\u200b\u5df2\u200b\u958b\u653e\u200b <code>8008</code> \u200b\u9023\u63a5\u200b\u57e0\u200b\uff08\u200b\u7ba1\u7406\u200b\u4e3b\u63a7\u53f0\u200b\uff09\uff0c\u200b\u5426\u5247\u200b\u5c07\u7121\u6cd5\u200b\u5f9e\u200b\u700f\u89bd\u5668\u200b\u9023\u5165\u200b\u8a2d\u5b9a\u200b\u9801\u200b\u9762\u200b\u3002</p>"},{"location":"metadefender-core/installation/#_4","title":"\u555f\u52d5\u200b\u8207\u200b\u6388\u6b0a","text":"<p>\u200b\u5b89\u88dd\u200b\u5b8c\u6210\u200b\u5f8c\u200b\uff0c\u200b\u78ba\u8a8d\u200b\u670d\u52d9\u200b\u72c0\u614b\u200b\u4e26\u958b\u555f\u200b\u7ba1\u7406\u200b\u4e3b\u63a7\u53f0\u200b\uff1a</p> <pre><code># \u200b\u78ba\u8a8d\u200b\u670d\u52d9\u200b\u662f\u5426\u200b\u6b63\u5e38\u200b\u904b\u4f5c\u200b\nsudo systemctl status ometascan\n\n# \u200b\u700f\u89bd\u5668\u200b\u958b\u555f\u200b\u4ee5\u4e0b\u200b\u4f4d\u5740\u200b\u9032\u884c\u200b\u521d\u59cb\u200b\u8a2d\u5b9a\u200b\u8207\u200b\u6388\u6b0a\u200b\n# http://&lt;\u200b\u4e3b\u6a5f\u200b IP&gt;:8008\n</code></pre> <p>\u200b\u4f9d\u756b\u9762\u200b\u6307\u793a\u200b\u8f38\u5165\u200b\u6388\u6b0a\u200b\u91d1\u200b\u9470\u200b\u5373\u53ef\u200b\u5b8c\u6210\u200b\u555f\u7528\u200b\u3002</p> <p>LAB \u200b\u74b0\u5883\u200b\u5c0f\u200b\u6280\u5de7\u200b</p> <p>\u200b\u5efa\u8b70\u200b\u642d\u914d\u200b Nginx Proxy Manager \u200b\u53cd\u5411\u200b\u4ee3\u7406\u200b\uff0c\u200b\u7d81\u200b\u4e00\u500b\u200b\u597d\u8a18\u200b\u7684\u200b\u5167\u90e8\u200b\u7db2\u57df\u200b\uff0c\u200b\u5c31\u200b\u4e0d\u7528\u200b\u6bcf\u6b21\u200b\u90fd\u8a18\u200b IP \u200b\u52a0\u9023\u200b\u63a5\u57e0\u200b\u3002\u200b\u9019\u4e5f\u200b\u65b9\u4fbf\u200b\u4e4b\u5f8c\u639b\u200b\u6191\u8b49\u200b\u8d70\u200b HTTPS\u3002</p>"},{"location":"metadefender-core/installation/#_5","title":"\u5e38\u898b\u200b\u96f7\u5340","text":"\u670d\u52d9\u8d77\u200b\u4e0d\u4f86\u200b\u3001\u200b\u9023\u4e0d\u9032\u200b 8008\uff1f <p>\u200b\u4f9d\u5e8f\u200b\u6aa2\u67e5\u200b\uff1a</p> <ol> <li><code>systemctl status ometascan</code> \u200b\u770b\u200b\u670d\u52d9\u200b\u662f\u5426\u200b\u771f\u7684\u200b\u5728\u200b\u8dd1\u200b</li> <li><code>ss -tlnp | grep 8008</code> \u200b\u78ba\u8a8d\u200b\u9023\u63a5\u200b\u57e0\u200b\u6709\u200b\u5728\u200b\u76e3\u807d\u200b</li> <li>\u200b\u9632\u706b\u200b\u7246\u200b\uff08<code>ufw</code> / <code>firewalld</code>\uff09\u200b\u662f\u5426\u200b\u653e\u884c\u200b</li> <li>\u200b\u82e5\u200b\u5728\u200b\u96f2\u7aef\u200b\u4e3b\u6a5f\u200b\uff08\u200b\u5982\u200b Azure\uff09\uff0c\u200b\u5225\u200b\u5fd8\u200b\u4e86\u200b\u5b89\u5168\u6027\u200b\u7fa4\u7d44\u200b / NSG \u200b\u4e5f\u200b\u8981\u200b\u958b\u200b 8008</li> </ol> <p>\u200b\u6700\u200b\u5f8c\u200b\u66f4\u65b0\u200b\uff1a2026-08-17</p>"},{"location":"metadefender-core/overview/","title":"MetaDefender Core \u200b\u4e2d\u6587\u200b\u5c0e\u8b80","text":"<p>\u200b\u9019\u7bc7\u7528\u200b\u767d\u8a71\u200b\u5e36\u200b\u4f60\u200b\u7406\u89e3\u200b MetaDefender Core \u200b\u662f\u200b\u4ec0\u9ebc\u200b\u3001\u200b\u89e3\u6c7a\u200b\u4ec0\u9ebc\u200b\u554f\u984c\u200b\uff0c\u200b\u9069\u5408\u200b\u7b2c\u4e00\u6b21\u200b\u63a5\u89f8\u200b\u7684\u200b\u540c\u4ec1\u200b\u6216\u200b\u5ba2\u6236\u200b\u5148\u200b\u770b\u200b\u3002</p>"},{"location":"metadefender-core/overview/#_1","title":"\u4e00\u53e5\u200b\u8a71\u200b\u7406\u89e3","text":"<p>MetaDefender Core \u200b\u662f\u200b\u4e00\u500b\u200b\u6a94\u6848\u200b\u5b89\u5168\u200b\u6aa2\u6e2c\u200b\u5f15\u64ce\u200b\uff1a\u200b\u4efb\u4f55\u200b\u8981\u200b\u9032\u5165\u200b\u4f60\u200b\u7d44\u7e54\u200b\u7684\u200b\u6a94\u6848\u200b\uff0c\u200b\u5148\u9001\u200b\u9032\u4f86\u200b\u300c\u200b\u5b89\u6aa2\u200b\u300d\uff0c\u200b\u78ba\u8a8d\u200b\u4e7e\u6de8\u200b\u3001\u200b\u7121\u5bb3\u200b\u3001\u200b\u5408\u898f\u200b\u4e4b\u5f8c\u624d\u200b\u653e\u884c\u200b\u3002</p> <p>\u200b\u4f60\u200b\u53ef\u4ee5\u200b\u628a\u200b\u5b83\u200b\u60f3\u50cf\u6210\u200b\u6a5f\u5834\u200b\u7684\u200b\u884c\u674e\u200b\u5b89\u6aa2\u7ad9\u200b \u2014\u2014 \u200b\u4e0d\u662f\u200b\u53ea\u9760\u200b\u4e00\u53f0\u200b\u6a5f\u5668\u200b\uff0c\u200b\u800c\u662f\u200b\u540c\u6642\u200b\u7528\u200b\u5f88\u591a\u200b\u7a2e\u200b\u65b9\u5f0f\u200b\u6aa2\u67e5\u200b\u540c\u200b\u4e00\u4ef6\u200b\u884c\u674e\u200b\uff0c\u200b\u4efb\u4f55\u200b\u4e00\u7a2e\u200b\u767c\u73fe\u200b\u554f\u984c\u200b\u90fd\u200b\u6703\u200b\u6514\u4e0b\u200b\u4f86\u200b\u3002</p>"},{"location":"metadefender-core/overview/#_2","title":"\u4e09\u5927\u200b\u6838\u5fc3\u200b\u80fd\u529b","text":"\u80fd\u529b\u200b \u200b\u767d\u8a71\u200b\u8aaa\u660e\u200b \u200b\u5c0d\u61c9\u200b\u5a01\u8105\u200b Multiscanning \u200b\u540c\u6642\u200b\u7528\u200b\u591a\u5957\u200b\u9632\u6bd2\u200b\u5f15\u64ce\u200b\u6383\u63cf\u200b\u540c\u4e00\u200b\u500b\u200b\u6a94\u6848\u200b \u200b\u5df2\u77e5\u200b\u75c5\u6bd2\u200b\u3001\u200b\u60e1\u610f\u200b\u7a0b\u5f0f\u200b Deep CDR \u200b\u628a\u200b\u6a94\u6848\u200b\u62c6\u89e3\u200b\u91cd\u7d44\u200b\uff0c\u200b\u79fb\u9664\u200b\u53ef\u80fd\u200b\u85cf\u6bd2\u200b\u7684\u200b\u5143\u4ef6\u200b \u200b\u672a\u77e5\u200b\u5a01\u8105\u200b\u3001\u200b\u96f6\u6642\u200b\u5dee\u200b\u653b\u64ca\u200b Sandbox \u200b\u5728\u200b\u9694\u96e2\u200b\u74b0\u5883\u200b\u5be6\u969b\u200b\u300c\u200b\u5f15\u7206\u200b\u300d\u200b\u6a94\u6848\u200b\u89c0\u5bdf\u884c\u200b\u70ba\u200b \u200b\u9032\u968e\u898f\u200b\u907f\u578b\u200b\u60e1\u610f\u200b\u7a0b\u5f0f\u200b <p>\u200b\u70ba\u200b\u4ec0\u9ebc\u200b\u8981\u200b\u7528\u200b\u591a\u5957\u200b\u5f15\u64ce\u200b\uff1f</p> <p>\u200b\u6c92\u6709\u200b\u4efb\u4f55\u200b\u4e00\u5957\u200b\u9632\u6bd2\u200b\u5f15\u64ce\u200b\u80fd\u200b\u6293\u200b\u5230\u200b\u6240\u6709\u200b\u75c5\u6bd2\u200b\u3002\u200b\u591a\u5957\u200b\u5f15\u64ce\u200b\u4e00\u8d77\u200b\u6383\u200b\uff0c\u200b\u7b49\u200b\u65bc\u200b\u591a\u96d9\u200b\u773c\u775b\u200b\u540c\u6642\u200b\u770b\u200b\uff0c\u200b\u6293\u5230\u200b\u7387\u200b\u5927\u5e45\u200b\u63d0\u5347\u200b \u2014\u2014 \u200b\u9019\u200b\u6b63\u662f\u200b Multiscanning \u200b\u7684\u200b\u6838\u5fc3\u200b\u50f9\u503c\u200b\u3002</p>"},{"location":"metadefender-core/overview/#_3","title":"\u5178\u578b\u200b\u4f7f\u7528\u200b\u5834\u666f","text":"<ul> <li>\u200b\u4e0a\u50b3\u200b\u6a94\u6848\u200b\u6383\u63cf\u200b\uff1a\u200b\u7db2\u7ad9\u200b\u3001\u200b\u61c9\u7528\u200b\u7cfb\u7d71\u200b\u6536\u5230\u200b\u4f7f\u7528\u8005\u200b\u4e0a\u50b3\u200b\u7684\u200b\u6a94\u6848\u200b\uff0c\u200b\u5148\u904e\u200b\u4e00\u6b21\u200b Core \u200b\u518d\u200b\u5132\u5b58\u200b\u3002</li> <li>\u200b\u4f9b\u61c9\u200b\u93c8\u200b\u5b89\u5168\u200b\uff1a\u200b\u5916\u90e8\u200b\u5ee0\u5546\u200b\u4ea4\u4ed8\u200b\u7684\u200b\u6a94\u6848\u200b\u3001\u200b\u7a0b\u5f0f\u200b\u78bc\u200b\uff0c\u200b\u9032\u5834\u200b\u524d\u200b\u5148\u6aa2\u6e2c\u200b\u3002</li> <li>\u200b\u53ef\u651c\u5f0f\u200b\u5a92\u9ad4\u200b\u7ba1\u63a7\u200b\uff1a\u200b\u642d\u914d\u200b Kiosk\uff0cUSB \u200b\u96a8\u8eab\u200b\u789f\u200b\u63d2\u5165\u200b\u524d\u5f37\u200b\u5236\u5b89\u6aa2\u200b\u3002</li> </ul> <p>\u200b\u66f4\u591a\u7b46\u200b\u8a18\u9678\u7e8c\u200b\u88dc\u4e0a\u200b</p> <p>\u200b\u5b89\u88dd\u200b\u90e8\u7f72\u200b\u3001\u200b\u591a\u200b\u5f15\u64ce\u200b\u8a2d\u5b9a\u200b\u3001Deep CDR \u200b\u5be6\u4f5c\u200b\u7b49\u200b\u5167\u5bb9\u6703\u200b\u9678\u7e8c\u200b\u52a0\u5165\u200b\u672c\u7ad9\u200b\u3002</p>"}]}